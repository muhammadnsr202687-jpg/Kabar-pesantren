            let sizeClass = 'text-sm';
            if (fontSizeLevel === 1) sizeClass = 'text-base';
            if (fontSizeLevel === 2) sizeClass = 'text-lg';
            if (fontSizeLevel === -1) sizeClass = 'text-xs';

            articleBody.forEach(el => {
                el.className = `article-body text-slate-700 leading-relaxed space-y-4 font-sans ${sizeClass}`;
            });
        }

        function resetFontSize() {
            fontSizeLevel = 0;
            const articleBody = document.querySelectorAll('.article-body');
            articleBody.forEach(el => {
                el.className = 'article-body text-slate-700 leading-relaxed space-y-4 font-sans text-sm md:text-base';
            });
        }

        // NEWSLETTER SUBMIT
        function handleNewsletterSubmit(e) {
            e.preventDefault();
            alert('Jazakallah Khairan! Email Anda berhasil terdaftar pada Buletin Jumat.');
            e.target.reset();
        }

        // MOBILE DRAWER MENU TOGGLE
        document.getElementById('mobile-menu-btn').addEventListener('click', () => {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        });
    </script>
</body>
</html>
